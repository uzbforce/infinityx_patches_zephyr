diff --git a/infinity_zephyr.mk b/infinity_zephyr.mk
new file mode 100644
index 0000000..589cd1c
--- /dev/null
+++ b/infinity_zephyr.mk
@@ -0,0 +1,78 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# Inherit from those products. Most specific first.
+#
+# Still core_64_bit_only.mk: stock runs zygote64_32, but this tree cannot build
+# a 32-bit world yet (the installed kernel uapi headers are arm64-only, and the
+# stock vendor blobs are declared 64-bit-only). See the device tree README.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
+$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
+
+# ---------------------------------------------------------------------------
+# Infinity X configuration
+#
+# These must be set before vendor/infinity/config/common.mk is inherited:
+# common.mk defaults WITH_GAPPS to true and only hard-includes the release
+# keys when the build type is OFFICIAL.
+# ---------------------------------------------------------------------------
+INFINITY_BUILD       := zephyr
+INFINITY_BUILD_TYPE  := UNOFFICIAL
+INFINITY_MAINTAINER  := uzbforce
+
+# No GMS yet: the VANILLA product keeps the full Infinity X feature set and
+# ships without Play services/Play Store/SetupWizard.
+WITH_GAPPS := false
+WITH_GMS   := false
+
+# Fingerprint on display. This selects Infinity's UDFPS theme overlay and the
+# screen-off UDFPS defaults the framework reads from the device overlay.
+TARGET_HAS_UDFPS := true
+
+# Inherit from Infinity X common configuration
+$(call inherit-product, vendor/infinity/config/common_full_phone.mk)
+
+# Inherit the hardware configuration for the actual device
+$(call inherit-product, device/xiaomi/zephyr/device.mk)
+
+# Signing keys, when present. common.mk already includes these for OFFICIAL
+# builds; the -include keeps a local build working when the keys are absent.
+-include vendor/infinity-priv/keys/keys.mk
+
+# ---------------------------------------------------------------------------
+# Identity
+# ---------------------------------------------------------------------------
+PRODUCT_NAME         := infinity_zephyr
+PRODUCT_DEVICE       := zephyr
+PRODUCT_MANUFACTURER := Xiaomi
+PRODUCT_BRAND        := Redmi
+PRODUCT_MODEL        := Redmi Note 17 4G
+
+PRODUCT_SYSTEM_NAME   := zephyr_global
+PRODUCT_SYSTEM_DEVICE := zephyr
+
+# Stock images are EROFS
+WITH_EROFS := true
+
+# Impersonate the stock firmware. Infinity's gen_build_prop.py reports every
+# non-eng build as `user`, and init's SPOOF_SAFETYNET path repeats the same
+# values at boot. The vendor blobs and Play Integrity checks were tested
+# against this identity, and this is an unofficial Android 17 port of the
+# stock Android 16 firmware, so it keeps reporting the stock build. ADB
+# authentication is therefore on: authorize the host in SystemUI after the
+# first boot.
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildDesc="zephyr_global-user 16 BP2A.250605.031.A3 OS3.0.310.0.WBUMIXM release-keys" \
+    BuildFingerprint=Redmi/zephyr_global/zephyr:16/BP2A.250605.031.A3/OS3.0.310.0.WBUMIXM:user/release-keys
+
+PRODUCT_GMS_CLIENTID_BASE := android-xiaomi
+
+# ---------------------------------------------------------------------------
+# Display: 1080x2280 AMOLED, 120 Hz (verified from the stock DTBs)
+# ---------------------------------------------------------------------------
+TARGET_SUPPORTED_REFRESH_RATES := 60,90,120
+
+$(call soong_config_set,surfaceflinger,frame_rate_category_high,120)
+$(call soong_config_set,surfaceflinger,frame_rate_category_min,60)
