diff --git a/configs/init/android.hardware.sensors@2.1-service-multihal.rc b/configs/init/android.hardware.sensors@2.1-service-multihal.rc
new file mode 100644
index 0000000..de39d54
--- /dev/null
+++ b/configs/init/android.hardware.sensors@2.1-service-multihal.rc
@@ -0,0 +1,15 @@
+# The stock HIDL sensors multihal and the AIDL multihal from hardware/xiaomi
+# both serve android.hardware.sensors and both load the same sub-HALs
+# (sensors.ssc.so, sensors.touch.detect.so, sensors.xiaomi.zephyr.udfps.so).
+# The AIDL service is the one this product declares in VINTF and the one the
+# framework uses, so keep the stock service definition (the binary still
+# ships) but never start it: with both running, the HIDL instance stays
+# blocked in sub-HAL initialize() and takes the SSC registry down with it.
+service vendor.sensors-hal-2-1-multihal /vendor/bin/hw/android.hardware.sensors@2.1-service.multihal
+    class hal
+    user system
+    group system wakelock context_hub input
+    task_profiles ServiceCapacityLow
+    capabilities BLOCK_SUSPEND
+    rlimit rtprio 10 10
+    disabled
