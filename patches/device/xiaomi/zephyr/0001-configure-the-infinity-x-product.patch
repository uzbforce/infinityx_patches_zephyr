diff --git a/sepolicy/vendor/file.te b/sepolicy/vendor/file.te
index 1f2ca8c..782c2c5 100644
--- a/sepolicy/vendor/file.te
+++ b/sepolicy/vendor/file.te
@@ -49,3 +49,25 @@ type xiaomi_touch_device, dev_type;
 #   sscrpcd: apps_std_fopen_with_env failed with 0xd for
 #     proc/tp_proximity_switch (Permission denied)
 type proc_tp_proximity_data, fs_type, proc_type;
+
+# The touch controller's chip_name node, read by sscrpcd before it brings the
+# SSC sensor registry up. Stock labels this exact I2C path sysfs_chip_name;
+# this build's policy comes from device/qcom/sepolicy_vndr/sm6225, which does
+# not know zephyr's bus number, so the node falls back to the generic sysfs
+# label and the daemon is denied on every startup pass:
+#
+#   avc: denied { read } for comm="sscrpcd" name="chip_name" dev="sysfs"
+#     scontext=u:r:vendor_sensors:s0 tcontext=u:object_r:sysfs:s0 tclass=file
+#
+# The read gates the touch-detect configuration, so the SSC registry never
+# becomes ready and the sensors HAL stays blocked in sub-HAL initialize().
+type sysfs_chip_name, sysfs_type;
+
+# /sys/devices/virtual/touch/touch_dev/palm_sensor, written by the touch
+# detect sub-HAL to enable palm rejection. Stock labels it
+# vendor_sysfs_touch_node; without the label the write lands on the generic
+# sysfs type and is denied (see vendor_sensors.te):
+#
+#   avc: denied { write } for comm="android.hardwar" name="palm_sensor"
+#     scontext=u:r:hal_sensors_default:s0 tcontext=u:object_r:sysfs:s0 tclass=file
+type vendor_sysfs_touch_node, sysfs_type;
diff --git a/sepolicy/vendor/file_contexts b/sepolicy/vendor/file_contexts
index b4948d5..7974737 100644
--- a/sepolicy/vendor/file_contexts
+++ b/sepolicy/vendor/file_contexts
@@ -59,6 +59,17 @@
 # in displayfeature.te.
 /dev/mi_display/disp_feature      u:object_r:vendor_displayfeature_device:s0
 
+# The AIDL sensors multihal is built from hardware/xiaomi/aidl/sensors, and
+# AOSP's hal_sensors_default_exec patterns match only the .multihal and
+# @X.Y-service.multihal names. Without an entry the binary stays vendor_file,
+# init finds no domain for the service, and the AIDL ISensors instance is
+# never registered. The framework then sits in
+# AidlSensorHalWrapper::connect()/AServiceManager_waitForService() long enough
+# for the system_server watchdog to kill the system process before boot
+# completes. Keep the AIDL HAL in the same domain as the HIDL one so every
+# device-node rule in vendor_sensors.te applies unchanged.
+/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors-service\.xiaomi-multihal u:object_r:hal_sensors_default_exec:s0
+
 # Xiaomi charging HAL; see hal_micharge_default.te. The binary shipped as a
 # plain vendor_file blob, so init found no domain transition and the service
 # never started (lshal shows IMiCharge dead).
diff --git a/sepolicy/vendor/genfs_contexts b/sepolicy/vendor/genfs_contexts
index 5acac45..de98f60 100644
--- a/sepolicy/vendor/genfs_contexts
+++ b/sepolicy/vendor/genfs_contexts
@@ -66,3 +66,11 @@ genfscon sysfs /devices/platform/soc/soc:vibrator_gpio/leds/vibrator/activate u:
 genfscon sysfs /devices/platform/soc/soc:vibrator_gpio/leds/vibrator/duration u:object_r:sysfs_leds:s0
 genfscon sysfs /devices/platform/soc/soc:vibrator_gpio/leds/vibrator/state u:object_r:sysfs_leds:s0
 genfscon sysfs /devices/platform/soc/soc:vibrator_gpio/leds/vibrator/brightness u:object_r:sysfs_leds:s0
+
+# The touch controller's chip_name and palm_sensor attributes. Both are owned
+# by the sensor stack: sscrpcd reads chip_name to identify the panel before it
+# starts the SSC registry, and the touch detect sub-HAL writes palm_sensor.
+# Stock labels them sysfs_chip_name / vendor_sysfs_touch_node; see file.te for
+# the denials that result when they fall back to the generic sysfs type.
+genfscon sysfs /devices/platform/soc/4ac0000.qcom,qupv3_0_geni_se/4a80000.i2c/i2c-0/0-0028/chip_name u:object_r:sysfs_chip_name:s0
+genfscon sysfs /devices/virtual/touch/touch_dev/palm_sensor u:object_r:vendor_sysfs_touch_node:s0
diff --git a/sepolicy/vendor/vendor_sensors.te b/sepolicy/vendor/vendor_sensors.te
index cfbe9c0..8d1a8f7 100644
--- a/sepolicy/vendor/vendor_sensors.te
+++ b/sepolicy/vendor/vendor_sensors.te
@@ -12,6 +12,12 @@
 # while the proximity sensor is armed.
 allow vendor_sensors proc_tp_proximity_data:file rw_file_perms;
 
+# sscrpcd identifies the touch controller through chip_name before it starts
+# the SSC sensor registry. The node is labelled sysfs_chip_name in
+# genfs_contexts; without this rule the read is denied and the registry never
+# comes up, which in turn leaves the sensors HAL blocked in initialize().
+allow vendor_sensors sysfs_chip_name:file r_file_perms;
+
 # The UDFPS sensors sub-HAL arms the touch controller's FOD mode through the
 # xiaomi_tp command node, then watches the driver's press flag to deliver the
 # one-shot doze trigger. The touch feature service normally owns this node;
@@ -20,3 +26,8 @@ allow vendor_sensors proc_tp_proximity_data:file rw_file_perms;
 allow hal_sensors_default xiaomi_touch_device:chr_file rw_file_perms;
 allow hal_sensors_default sysfs:dir r_dir_perms;
 allow hal_sensors_default sysfs:file r_file_perms;
+
+# The touch detect sub-HAL enables palm rejection by writing palm_sensor. The
+# generic sysfs rule above is read-only and the node has its own label, so the
+# write needs this rule as well.
+allow hal_sensors_default vendor_sysfs_touch_node:file rw_file_perms;
